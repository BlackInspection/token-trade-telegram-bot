{
  "name": "solana-crypto-telegram-trading-bot",
  "version": "1.3.89",
  "description": "Token analyzer + practice / link / live trading bot (DexScreener, GoPlus, GeckoTerminal, Jupiter, KyberSwap) with a grammY Telegram interface",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "bin": {
    "tradebot": "src/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js run",
    "mock": "node src/index.js mock --cycles 2",
    "analyze": "node src/index.js analyze",
    "backtest": "node src/index.js backtest",
    "test": "node --test",
    "doctor": "node src/index.js doctor",
    "trackrecord": "node src/index.js trackrecord"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@solana/web3.js": "^1.99.0",
    "ethers": "^6.17.0"
  }
}
