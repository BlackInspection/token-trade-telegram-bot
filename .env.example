# ============================================================
# crypto-trading-bot - example .env (copy to .env)
# Every key is optional unless marked as required for a mode.
# ============================================================

# --- Telegram ---
# Bot token from @BotFather. Empty -> the bot does not start and notifications go to stdout.
BOT_TOKEN=
# Telegram user ids of the admins, comma-separated (only they can use the bot). Required when BOT_TOKEN is set.
ADMIN_IDS=

# --- Modes and safety ---
# Hard lock. true (default): nothing real is ever bought - no bot command or stored setting can override it.
# Live executors only log "DRY: would ..." and record the trade in SQLite with the dry flag.
DRY_RUN=true
# practice (= paper, default) | link | live. Switch in the bot with /mode.
#   practice: simulated fills on a practice account.
#   link:     "sign it yourself" - the bot sends Phantom / Jupiter / Uniswap swap links and never sees a key.
#             Recommended for anyone who should not put a private key in this file.
#   live:     autopilot with a hot-wallet key; needs DRY_RUN=false, graduation (/mode live) and a confirm button.
#             TRADING_MODE=live here never skips that: until /mode live is confirmed in the bot it runs as practice.
TRADING_MODE=paper
# SQLite path (relative to the project root).
DB_PATH=data/tradebot.db
# debug | info | warn | error
LOG_LEVEL=info
# Initial watchlist (comma-separated addresses) - handy without Telegram.
WATCHLIST=
# Strategy name (only one for now: ema_cross_rsi).
STRATEGY=ema_cross_rsi

# --- Data sources (public APIs, no keys needed) ---
DEXSCREENER_URL=https://api.dexscreener.com
GOPLUS_URL=https://api.gopluslabs.io
# Optional GoPlus access token for higher rate limits.
GOPLUS_ACCESS_TOKEN=
GECKOTERMINAL_URL=https://api.geckoterminal.com/api/v2
HONEYPOT_IS_URL=https://api.honeypot.is
# Extra buy/sell simulation via honeypot.is (Ethereum, BSC, Base).
USE_HONEYPOT_IS=true
HTTP_TIMEOUT_MS=15000
# Cache of GoPlus / honeypot.is results for watched tokens, seconds (held tokens use GUARDIAN_SECURITY_SEC).
SECURITY_CACHE_SEC=900

# --- Analysis / strategy ---
# Candle timeframe: 1m 5m 15m 1h 4h 12h 1d
TIMEFRAME=5m
# How many candles to fetch (max 1000).
OHLCV_LIMIT=300
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
# Enter only when RSI is within [RSI_MIN_ENTRY, RSI_OVERBOUGHT].
RSI_MIN_ENTRY=45
RSI_OVERBOUGHT=70
# Signal exit when RSI >= RSI_EXIT.
RSI_EXIT=80
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14
VOL_LOOKBACK=20
VOL_SPIKE_MULT=2
# An EMA cross counts as "fresh" if it happened at most N bars ago.
CROSS_LOOKBACK=3
# Hard AVOID rules: tax above the limit, liquidity below the minimum, honeypot, no sell route.
MAX_BUY_TAX_PCT=10
MAX_SELL_TAX_PCT=10
MIN_LIQUIDITY_USD=20000
# Buy only when risk <= MAX_BUY_RISK; risk >= AVOID_RISK means AVOID.
MAX_BUY_RISK=40
AVOID_RISK=70
# Stop = ATR * ATR_SL_MULT, kept within [MIN_SL_PCT, MAX_SL_PCT] % of price; DEFAULT_SL_PCT without ATR.
ATR_SL_MULT=2
MIN_SL_PCT=2
MAX_SL_PCT=25
DEFAULT_SL_PCT=10
# Take-profit = entry + stop distance * TP_RR (0 = no TP, trailing stop only).
TP_RR=2

# --- Trading and risk limits (checked on every spend path) ---
# Practice account starting balance, USD.
PAPER_START_EQUITY=1000
# Position size: fixed USD, or % of practice equity when POSITION_SIZE_PCT > 0.
POSITION_SIZE_USD=50
POSITION_SIZE_PCT=0
# Hard maximum per trade, USD (manual /buy included).
# The default limits below (200 / 500 / 10 per hour) equal the "bold" preset's; /preset normal or careful tightens them.
MAX_TRADE_USD=200
MAX_OPEN_POSITIONS=3
# Daily loss limit (realized PnL per UTC day), USD. 0 = off.
DAILY_LOSS_LIMIT_USD=100
# Daily spend budget (sum of buys per UTC day), USD. 0 = off.
DAILY_BUDGET_USD=500
# Maximum buys per hour.
MAX_TRADES_PER_HOUR=10
# Real-money buys (link or live mode) above this always ask for a confirmation: automatic buys, and manual /buy even
# with BUY_CONFIRM=false. Practice buys never ask. Empty = half of MAX_TRADE_USD.
CONFIRM_ABOVE=
# Flat slippage, bps (100 = 1%), sent with every Jupiter and 0x quote. Practice fills use the pool's price impact
# instead when it is known. /settings slippage_bps changes it at runtime (raising it waits LOOSEN_DELAY_HOURS).
SLIPPAGE_BPS=100
# Practice fill fee, bps.
FEE_BPS=30
# Trailing stop, % below the highest price since entry. 0 = off.
TRAILING_STOP_PCT=10
# Watchlist re-analysis interval, seconds.
WATCH_INTERVAL_SEC=60

# --- Exit Test: round-trip cost, quotes and the cost gate (all prices shown are net) ---
# Real round-trip quotes (Jupiter on Solana, KyberSwap on EVM) on analyze, /buy, /cost and for open positions.
USE_QUOTES=true
KYBER_API_URL=https://aggregator-api.kyberswap.com
KYBER_CLIENT_ID=tradebot
# Quote cache per chain:token:size, seconds.
QUOTE_CACHE_SEC=60
# DEX pool fee per swap for estimates, bps. TODO(verify): real pools charge 0.01%-1%.
DEX_FEE_BPS=30
# Hard AVOID when buying POSITION_SIZE_USD and selling right away loses more than this, %.
MAX_ROUNDTRIP_PCT=15
# "Largest buy under X% round trip" in reports, %.
SAFE_ROUNDTRIP_PCT=3
# Automatic entries need a target of at least COST_GATE_MULT x the round-trip loss.
COST_GATE_MULT=3
# Risk penalty (roundTripHigh) when the round trip at POSITION_SIZE_USD loses more than this, %.
ROUND_TRIP_WARN_PCT=5
# Optional minimum net profit at the target for automatic entries (0 = off). Fails are logged as FEES_EAT_PROFIT.
MIN_NET_PROFIT_USD=0
MIN_NET_PROFIT_PCT=0
# Gas per swap in USD, used in every net number. TODO(verify): rough defaults, real gas varies with load.
GAS_USD_SOL=0.01
GAS_USD_ETH=2
GAS_USD_BSC=0.1
GAS_USD_BASE=0.02
GAS_USD_OTHER=0.05
# /buy shows a confirmation card ("Put in $200, sell right away, get back about $185") before buying.
BUY_CONFIRM=true

# --- Verdict card and "Is this the real one?" ---
# GREEN needs a risk score at or below this (and >= 80% of checks done, no copycat, sources agree).
LIGHT_GREEN_MAX=20
# RugCheck fills the Solana LP-lock gap GoPlus leaves.
USE_RUGCHECK=true
RUGCHECK_URL=https://api.rugcheck.xyz
JUPITER_TOKENS_URL=https://lite-api.jup.ag/tokens/v2
# Identity cache (listed / possible copycat), seconds. Search results are cached 1 h.
IDENTITY_CACHE_SEC=86400
# Colored buttons (Bot API 9.4 "style"); a Telegram 400 is retried once without style.
UI_BUTTON_COLORS=true
# [Practice-buy $X] button size, USD (always the practice account).
PRACTICE_BUY_USD=25

# --- Position Guardian: "what changed since you bought" ---
# Early warning, not insurance: polling cannot beat a same-block rug.
GUARDIAN_ENABLED=true
# Held tokens re-check security at most this often, seconds (GoPlus free tier: 150 CU/min).
GUARDIAN_SECURITY_SEC=300
GUARDIAN_TAX_UP_PTS=5
GUARDIAN_LIQ_DROP_PCT=30
GUARDIAN_LIQ_DROP_ENTRY_PCT=50
GUARDIAN_LP_LOCK_DROP_PTS=20
GUARDIAN_TOP10_UP_PTS=10
# Warn events tighten the stop to price - X%.
GUARDIAN_TIGHTEN_PCT=5
# Auto-exit with real funds on a critical event. false = alert only (practice and DRY_RUN always exit).
GUARDIAN_LIVE_EXIT=false
GUARDIAN_ALERT_COOLDOWN_MIN=30

# --- Track record: the bot grades its own calls, losers included ---
TRACK_ENABLED=true
TRACK_HORIZONS=1h,24h,7d
TRACK_INTERVAL_SEC=900
# At most one observation per token per N minutes.
OBS_DEDUPE_MIN=60
# Liquidity below max(this, 10% of the observed liquidity) counts as rugged.
TRACK_RUG_LIQ_USD=1000
# "small sample" below this n.
TRACK_MIN_N=20
# For BUY calls, check on 24h candles whether the target came before the stop.
TRACK_TP_CHECK=true
TRACK_MAX_OHLCV_PER_RUN=10

# --- Safe ladder: practice -> sign it yourself -> autopilot, with seatbelts ---
# Sample tokens for the /start tour (chain:address). Never DexScreener boosted lists (paid promotions).
SAMPLE_TOKENS=solana:DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263,ethereum:0x6982508145454Ce325dDbE47a25d4ec3d2311933
# Monthly loss budget, USD. 0 = not set yet (asked in /start). New buys stop when it is used up.
LOSS_BUDGET_MONTH_USD=0
# Pause after N losing closes in a row, for LOSS_STREAK_COOLDOWN_MIN minutes ("/buy ... override <reason>" skips it).
LOSS_STREAK_PAUSE=3
LOSS_STREAK_COOLDOWN_MIN=120
# No re-buy of a token within N minutes of its stop-loss.
REVENGE_BLOCK_MIN=60
# Changes that loosen a limit or seatbelt take effect after this many hours; tightening is instant.
LOOSEN_DELAY_HOURS=24
# Graduation to live autopilot (with DRY_RUN=false). The phrase counts only when typed with the command, in one
# message: /mode live I can lose this money
GRADUATION_MIN_PAPER_TRADES=10
GRADUATION_PHRASE=I can lose this money

# --- Explained decisions: event log, daily digest, optional AI explanation ---
# Event log (one JSON object per line), rotated to .1 at EVENTS_MAX_MB.
EVENTS_FILE=data/events.jsonl
EVENTS_MAX_MB=20
# Daily digest time (HH:MM) and its IANA time zone, e.g. Europe/Berlin or America/New_York.
DIGEST_AT=21:00
DIGEST_TZ=UTC
# Opt-in: event log paths (comma-separated) of your other bots that write the same event format; the digest
# adds one "Other bots" line with their buys and spend.
PEER_EVENT_FILES=
# Optional [Explain more] button. Empty = hidden and no network call is made.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Shadow-first rules and the safety envelope ---
# New watched tokens start as shadow rules: in live mode they record what they would buy, nothing is spent.
SHADOW_NEW_RULES=true
SHADOW_MIN_HOURS=24
SHADOW_MIN_MATCHES=5
SHADOW_MAX_HOURS=168
# Pause new entries after N executor errors in a row (until you tap Resume or send /resume).
AUTO_PAUSE_ERRORS=5
# Live mode (DRY_RUN=false): the hot wallet's USDC balance is read every 5 min. Pause and alert when it is more than
# this % below any reading of the last 24 h, beyond the bot's own buys and sells. Real-funds buys wait for Resume. 0 = off.
AUTO_PAUSE_BALANCE_DROP_PCT=30
# Pause new entries when market data is older than this (seconds); the bot resumes on its own when fresh data arrives.
STALE_DATA_SEC=300
# doctor warns when the hot wallet holds more than X x DAILY_BUDGET_USD.
HOT_WALLET_WARN_X=3

# --- Money display ---
# usd | rub | eur | none. USDC ~ 1 USD; if FX fails only USD is shown.
DISPLAY_CURRENCY=usd
FX_CACHE_SEC=300

# --- LIVE: Solana / Jupiter (only for TRADING_MODE=live with DRY_RUN=false) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Private key: base58 (Phantom export) or a JSON array of 64 numbers (solana-keygen file). NEVER commit it.
SOLANA_PRIVATE_KEY=
# lite-api.jup.ag works without a key; api.jup.ag needs JUPITER_API_KEY.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
# What buys are paid with and sells return to (USDC by default).
SOLANA_QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_QUOTE_DECIMALS=6

# --- LIVE: EVM / 0x (only for TRADING_MODE=live with DRY_RUN=false) ---
# Wallet private key (0x...). NEVER commit it.
EVM_PRIVATE_KEY=
# RPC per chain: chain=url, comma-separated, e.g. ethereum=https://...,base=https://...,bsc=https://...
EVM_RPC_URLS=
ZEROX_API_URL=https://api.0x.org
# 0x Swap API key (https://dashboard.0x.org).
ZEROX_API_KEY=

# In DRY_RUN the live executors fetch a quote (Jupiter / 0x) for information. false = no network.
DRY_RUN_QUOTES=true
